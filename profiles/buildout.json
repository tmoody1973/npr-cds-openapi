{
  "$schema": "https://json-schema.org/draft/2019-09/schema",
  "$id": "https://content.api.npr.org/v1/profiles/buildout.json",
  "title": "Buildout",
  "description": "A document that should have a non-empty layout property, or one that implements one or more 'built out' profiles",
  "definitions": {
    "buildoutProfileLink": {
      "description": "A profile link that can represent a built out document",
      "type": "object",
      "required": [
        "href"
      ],
      "properties": {
        "href": {
          "type": "string",
          "enum": [
            "/v1/profiles/blog",
            "/v1/profiles/series",
            "/v1/profiles/collection",
            "/v1/profiles/topic",
            "/v1/profiles/podcast-category",
            "/v1/profiles/podcast-channel",
            "/v1/profiles/biography",
            "/v1/profiles/program"
          ]
        }
      }
    }
  },
  "anyOf": [
    {
      "type": "object",
      "required": [
        "profiles"
      ],
      "properties": {
        "profiles": {
          "description": "List of profiles that this document is intended to implement",
          "type": "array",
          "contains": {
            "$ref": "#/definitions/buildoutProfileLink"
          }
        }
      }
    },
    {
      "allOf": [
        {
          "type": "object",
          "required": [
            "layout"
          ],
          "properties": {
            "layout": {
              "description": "Links to the assets intended to make up the layout of this document.",
              "type": "array",
              "minItems": 1
            }
          }
        },
        {
          "$ref": "../schemas/has-layout.json"
        }
      ]
    }
  ]
}
