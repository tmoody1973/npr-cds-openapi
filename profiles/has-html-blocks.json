{
  "$schema": "https://json-schema.org/draft/2019-09/schema",
  "$id": "https://content.api.npr.org/v1/profiles/has-html-blocks.json",
  "title": "Has HTML Blocks",
  "description": "A document with html block assets",
  "type": "object",
  "required": [
    "html-blocks"
  ],
  "properties": {
    "html-blocks": {
      "description": "The assets or documents representing the html block content of this document",
      "type": "array",
      "minLength": 1,
      "items": {
        "$ref": "../schemas/asset-link.json",
        "unevaluatedProperties": false
      }
    }
  }
}
