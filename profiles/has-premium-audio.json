{
  "$schema": "https://json-schema.org/draft/2019-09/schema",
  "$id": "https://content.api.npr.org/v1/profiles/has-premium-audio.json",
  "title": "Has Premium Audio",
  "description": "A document with premium audio",
  "type": "object",
  "required": [
    "premiumAudio"
  ],
  "properties": {
    "premiumAudio": {
      "description": "Links to the assets or documents representing premium audio content for this document",
      "type": "array",
      "minItems": 1,
      "items": {
        "allOf": [
          {
            "$ref": "../schemas/asset-link.json"
          },
          {
            "type": "object",
            "required": [
              "rels"
            ],
            "properties": {
              "rels": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "enum": [
                    "npr-plus",
                    "amazon-music"
                  ]
                }
              }
            }
          }
        ],
        "unevaluatedProperties": false
      }
    }
  }
}
