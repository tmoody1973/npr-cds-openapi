{
  "$schema": "https://json-schema.org/draft/2019-09/schema",
  "$id": "https://content.api.npr.org/v1/profiles/resource-container.json",
  "title": "Resource Container",
  "description": "A container document with size and content descriptors",
  "type": "object",
  "allOf": [
    {
      "$ref": "./container.json"
    },
    {
      "properties": {
        "title": {
          "description": "A human-readable title for this container",
          "type": "string",
          "minLength": 1
        },
        "introText": {
          "description": "Introduction text for the container.",
          "type": "string",
          "minLength": 1
        },
        "nprDisplayColumnSpan": {
          "description": "Size of the container to be displayed",
          "type": "string",
          "enum": [
            "inset",
            "fullWidth"
          ]
        }
      }
    }
  ]
}
