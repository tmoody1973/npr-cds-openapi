{
  "$schema": "https://json-schema.org/draft/2019-09/schema",
  "$id": "https://content.api.npr.org/v1/schemas/type-link.json",
  "title": "Type Link",
  "description": "A link defined with a mandatory 'type' rel",
  "allOf": [
    {
      "$ref": "./link.json"
    },
    {
      "type": "object",
      "required": [
        "rels"
      ],
      "properties": {
        "rels": {
          "type": "array",
          "contains": {
            "type": "string",
            "pattern": "^type$"
          },
          "items": {
            "type": "string"
          }
        }
      }
    }
  ]
}
