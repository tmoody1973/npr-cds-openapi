{
  "$schema": "https://json-schema.org/draft/2019-09/schema",
  "$id": "https://content.api.npr.org/v1/schemas/document-with-container-profile.json",
  "title": "Document with Container Profile",
  "description": "A document that is required to have a container profile in its profiles array.",
  "type": "object",
  "required": [
    "profiles"
  ],
  "properties": {
    "profiles": {
      "description": "List of profiles that this document is intended to implement",
      "type": "array",
      "contains": {
        "type": "object",
        "required": [
          "href"
        ],
        "properties": {
          "href": {
            "type": "string",
            "const": "/v1/profiles/container"
          }
        }
      }
    }
  }
}
