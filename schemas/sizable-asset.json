{
  "$schema": "https://json-schema.org/draft/2019-09/schema",
  "$id": "https://content.api.npr.org/v1/schemas/sizable-asset.json",
  "title": "Sizable Asset",
  "description": "A asset with multiple sizes",
  "type": "object",
  "properties": {
    "displaySize": {
      "type": "string",
