{
  "$schema": "https://json-schema.org/draft/2019-09/schema",
  "$id": "https://content.api.npr.org/v1/schemas/npr-website-fields.json",
  "title": "NPR Website Fields",
  "description": "NPR website metadata fields for linking content to the NPR website",
  "type": "object",
  "properties": {
    "nprWebsitePath": {
      "description": "Relative path to the content resource on the NPR website",
      "type": "string"
    },
    "nprDisplayType": {
      "description": "A reference to the type of rendering directive used by NPR for displaying this content",
      "type": "string",
      "enum": [
        "AboutPageMultimediaStory",
        "AboutPageStory",
        "AggAbout",
        "AggBookGenre",
        "AggNews",
        "Bio",
        "BlogAboutCategory",
        "BlogAboutIndex",
        "BlogAboutMultimediaStory",
        "BlogAboutStory",
        "BlogLiveNewsStory",
        "BlogLiveNewsMultimediaStory",
        "BlogLiveMusicStory",
        "BlogLiveMusicMultimediaStory",
        "BlogMusicCategory",
        "BlogMusicIndex",
        "BlogMusicLiveIndex",
        "BlogMusicMultimediaStory",
        "BlogMusicStory",
        "BlogNewsCategory",
        "BlogNewsIndex",
        "BlogNewsLiveIndex",
        "BlogNewsMultimediaStory",
        "BlogNewsStory",
        "BookAuthor",
        "BookBestseller",
        "BookLanding",
        "BookStory",
        "EventMusicAgg",
        "HomePage",
        "MusicAgg",
        "MusicArtist",
        "MusicHomepage",
        "MusicMultimedia",
        "MusicSongsStreamPlaylist",
        "MusicStory",
        "MusicStream",
        "NewsBioAgg",
        "NewsEpisode",
        "NewsMultimedia",
        "NewsNoRender",
        "NewsStory",
        "NewsSuperseries",
        "PodcastAgg",
        "PodcastChannel",
        "PodcastHome",
        "ProgramEpisode",
        "ProgramInterview",
        "ProgramMagazine",
        "ShowEpisode",
        "SponsorContentStory"
      ]
    }
  }
}
